generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  COMPANY
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  PENDING_VERIFICATION
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ResumeVisibility {
  PUBLIC
  PRIVATE
}

enum ResumeStatus {
  DRAFT
  COMPLETE
}

enum JobPostStatus {
  DRAFT
  OPEN
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  DOCUMENT_REVIEW
  INTERVIEW_REQUESTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ScoutStatus {
  PENDING
  OPENED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InterviewStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  AGREED
  SIGNED
  CANCELLED
}

enum VisaVerificationStatus {
  AI_ESTIMATE
  NEEDS_OFFICIAL_CHECK
  ADMIN_VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  role         Role
  status       AccountStatus @default(ACTIVE)
  name         String?
  locale       String        @default("ko")
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  oauthAccounts      OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  sessions           Session[]
  jobSeekerProfile   JobSeekerProfile?
  companyProfile     CompanyProfile?
  resumes            Resume[]
  applications       Application[]           @relation("SeekerApplications")
  jobScraps          JobScrap[]
  talentBookmarks    TalentBookmark[]        @relation("CompanyBookmarks")
  bookmarkedBy       TalentBookmark[]        @relation("BookmarkedTalent")
  talentViewLogs     TalentViewLog[]         @relation("ViewedTalent")
  talentViewsMade    TalentViewLog[]         @relation("ViewerCompanyUser")
  scoutOffersReceived ScoutOffer[]           @relation("ScoutReceiver")
  scoutOffersSent    ScoutOffer[]            @relation("ScoutSender")
  notifications      Notification[]
  conversationMembers ConversationMember[]
  messages           Message[]
  visaProfile        VisaProfile?
  interviewsAsSeeker Interview[]             @relation("InterviewSeeker")
  jobOffersReceived  JobOffer[]              @relation("OfferSeeker")
  contractsAsSeeker  EmploymentContract[]    @relation("ContractSeeker")
  auditLogs          AuditLog[]
  translations       TranslationUsage[]

  @@index([role, status])
  @@index([email])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model JobSeekerProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  name                 String?
  photoUrl             String?
  birthDate            DateTime?
  gender               Gender    @default(UNSPECIFIED)
  phone                String?
  residenceRegion      String?
  desiredWorkRegion    String?
  desiredJobCategory   String?
  desiredSalary        Int?
  desiredEmploymentType String?
  availableDate        DateTime?
  introduction         String?
  skills               String?
  careerYears          Int?
  languages            String?
  nationality          String?
  koreaResident        Boolean   @default(true)
  nativeLanguage       String?
  currentCountry       String?
  koreaLocation        String?
  koreanLevel          String?
  englishLevel         String?
  preferredLanguage    String?   @default("ko")
  autoTranslateEnabled Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([desiredJobCategory])
  @@index([desiredWorkRegion])
  @@index([nationality])
}

model CompanyProfile {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  companyName        String
  businessNumber     String?
  representative     String?
  industry           String?
  companySize        String?
  description        String?
  address            String?
  website            String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  logoUrl            String?
  verificationStatus CompanyVerificationStatus  @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosts           JobPost[]
  applications       Application[]
  scoutOffers        ScoutOffer[]
  interviews         Interview[]
  jobOffers          JobOffer[]
  contracts          EmploymentContract[]
  talentBookmarks    TalentBookmark[]
  talentViewLogs     TalentViewLog[]

  @@index([verificationStatus])
  @@index([companyName])
}

model Resume {
  id              String           @id @default(cuid())
  userId          String
  title           String
  profileSummary  String?
  desiredJob      String?
  desiredLocation String?
  desiredSalary   Int?
  employmentType  String?
  availableDate   DateTime?
  visibility      ResumeVisibility @default(PRIVATE)
  status          ResumeStatus     @default(DRAFT)
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  careers         ResumeCareer[]
  educations      ResumeEducation[]
  certificates    ResumeCertificate[]
  languages       ResumeLanguage[]
  skills          ResumeSkill[]
  portfolios      ResumePortfolio[]
  applications    Application[]

  @@index([userId, visibility])
  @@index([userId, isPrimary])
  @@index([visibility, status])
}

model ResumeCareer {
  id           String    @id @default(cuid())
  resumeId     String
  companyName  String
  jobTitle     String
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?
  leaveReason  String?
  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeEducation {
  id         String    @id @default(cuid())
  resumeId   String
  school     String
  major      String?
  degree     String?
  startDate  DateTime?
  endDate    DateTime?
  status     String?
  resume     Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeCertificate {
  id          String    @id @default(cuid())
  resumeId    String
  name        String
  issuer      String?
  acquiredAt  DateTime?
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeLanguage {
  id       String @id @default(cuid())
  resumeId String
  language String
  level    String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSkill {
  id       String @id @default(cuid())
  resumeId String
  name     String
  level    String?
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumePortfolio {
  id          String  @id @default(cuid())
  resumeId    String
  title       String
  url         String?
  description String?
  resume      Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model JobPost {
  id                    String        @id @default(cuid())
  companyId             String
  title                 String
  jobCategory           String?
  description           String?
  responsibilities      String?
  requirements          String?
  preferredConditions   String?
  employmentType        String?
  salaryType            String?
  salaryMin             Int?
  salaryMax             Int?
  workLocation          String?
  workDays              String?
  workHours             String?
  breakTime             String?
  recruitmentCount      Int?
  deadline              DateTime?
  foreignerAllowed      Boolean       @default(false)
  visaConditions        String?
  koreanLevel           String?
  housingSupport        Boolean       @default(false)
  mealSupport           Boolean       @default(false)
  transportationSupport Boolean       @default(false)
  educationRequirement  String?
  experienceRequirement String?
  status                JobPostStatus @default(DRAFT)
  views                 Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  company               CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications          Application[]
  scraps                JobScrap[]
  scoutOffers           ScoutOffer[]
  interviews            Interview[]
  jobOffers             JobOffer[]
  conversations         Conversation[]

  @@index([companyId, status])
  @@index([status, deadline])
  @@index([jobCategory])
  @@index([workLocation])
  @@index([foreignerAllowed])
  @@index([createdAt])
}

model Application {
  id           String            @id @default(cuid())
  jobPostId    String
  jobSeekerId  String
  resumeId     String
  companyId    String
  status       ApplicationStatus @default(APPLIED)
  memo         String?
  appliedAt    DateTime          @default(now())
  withdrawnAt  DateTime?
  updatedAt    DateTime          @updatedAt
  jobPost      JobPost           @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  jobSeeker    User              @relation("SeekerApplications", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  resume       Resume            @relation(fields: [resumeId], references: [id])
  company      CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  histories    ApplicationHistory[]
  interviews   Interview[]
  jobOffers    JobOffer[]
  contracts    EmploymentContract[]
  conversations Conversation[]
  aiPreScreens AiPreInterview[]

  @@unique([jobPostId, jobSeekerId])
  @@index([companyId, status])
  @@index([jobSeekerId, status])
  @@index([appliedAt])
}

model ApplicationHistory {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  createdAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model JobScrap {
  id         String   @id @default(cuid())
  userId     String
  jobPostId  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPost    JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostId])
  @@index([userId])
}

model TalentBookmark {
  id              String         @id @default(cuid())
  companyId       String
  jobSeekerId     String
  createdByUserId String
  createdAt       DateTime       @default(now())
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker       User           @relation("BookmarkedTalent", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("CompanyBookmarks", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, jobSeekerId])
  @@index([companyId])
}

model TalentViewLog {
  id              String         @id @default(cuid())
  companyId       String
  jobSeekerId     String
  viewerUserId    String
  createdAt       DateTime       @default(now())
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker       User           @relation("ViewedTalent", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  viewer          User           @relation("ViewerCompanyUser", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@index([jobSeekerId, createdAt])
  @@index([companyId, createdAt])
}

model ScoutOffer {
  id           String         @id @default(cuid())
  companyId    String
  jobSeekerId  String
  senderUserId String
  jobPostId    String?
  title        String
  message      String
  status       ScoutStatus    @default(PENDING)
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker    User           @relation("ScoutReceiver", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  sender       User           @relation("ScoutSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  jobPost      JobPost?       @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@index([jobSeekerId, status])
  @@index([companyId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  linkUrl   String?
  dataJson  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Conversation {
  id            String               @id @default(cuid())
  jobPostId     String?
  applicationId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  jobPost       JobPost?             @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  application   Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  members       ConversationMember[]
  messages      Message[]

  @@index([jobPostId])
  @@index([applicationId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentMeta String?
  translatedBody String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model VisaProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  visaType           String?
  visaStatus         String?
  issueDate          DateTime?
  expiryDate         DateTime?
  employmentAllowed  Boolean?
  verificationStatus VisaVerificationStatus  @default(AI_ESTIMATE)
  adminNote          String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([verificationStatus])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  companyId     String
  jobSeekerId   String
  jobPostId     String?
  interviewType String?
  scheduledAt   DateTime?
  durationMin   Int             @default(60)
  status        InterviewStatus @default(REQUESTED)
  meetingUrl    String?
  location      String?
  notes         String?
  reminder24hSent Boolean       @default(false)
  reminder1hSent  Boolean       @default(false)
  reminder10mSent Boolean       @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company       CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker     User            @relation("InterviewSeeker", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobPost       JobPost?        @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  aiPreScreens  AiPreInterview[]

  @@index([companyId, status])
  @@index([jobSeekerId, status])
  @@index([scheduledAt])
}

model AiPreInterview {
  id            String       @id @default(cuid())
  applicationId String
  interviewId   String?
  questionsJson String?
  answersJson   String?
  summary       String?
  highlights    String?
  followUps     String?
  disclaimer    String       @default("AI 결과는 참고용이며 자동 탈락/채용 결정에 사용되지 않습니다.")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interview     Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

model JobOffer {
  id             String         @id @default(cuid())
  applicationId  String
  companyId      String
  jobSeekerId    String
  jobPostId      String?
  salary         Int?
  employmentType String?
  workLocation   String?
  startDate      DateTime?
  workingHours   String?
  benefits       String?
  message        String?
  status         OfferStatus    @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker      User           @relation("OfferSeeker", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobPost        JobPost?       @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  contracts      EmploymentContract[]

  @@index([jobSeekerId, status])
  @@index([companyId, status])
}

model EmploymentContract {
  id              String         @id @default(cuid())
  applicationId   String
  companyId       String
  jobSeekerId     String
  jobOfferId      String?
  version         Int            @default(1)
  title           String
  contentOriginal String
  contentTranslated String?
  translationLang String?
  status          ContractStatus @default(DRAFT)
  integrityHash   String?
  signedAt        DateTime?
  signedBySeeker  Boolean        @default(false)
  signedByCompany Boolean        @default(false)
  auditJson       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker       User           @relation("ContractSeeker", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobOffer        JobOffer?      @relation(fields: [jobOfferId], references: [id], onDelete: SetNull)

  @@unique([applicationId, version])
  @@index([companyId, status])
  @@index([jobSeekerId, status])
}

model TranslationUsage {
  id           String   @id @default(cuid())
  userId       String?
  provider     String
  sourceLang   String?
  targetLang   String
  charCount    Int      @default(0)
  contextType  String?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  metaJson   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String?
  targetType  String
  targetId    String
  reason      String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
}

model IntegrationOutbox {
  id          String   @id @default(cuid())
  eventType   String
  payloadJson String
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@index([eventType])
}
