generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  COMPANY
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  PENDING
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ResumeVisibility {
  PRIVATE
  PUBLIC
}

enum ResumeStatus {
  DRAFT
  COMPLETE
}

enum JobPostStatus {
  DRAFT
  OPEN
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  APPLIED
  DOCUMENT_REVIEW
  INTERVIEW_REQUESTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ScoutStatus {
  PENDING
  OPENED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InterviewStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  ONLINE
  OFFLINE
  PHONE
  AI_PRESCREEN
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  AGREED
  SIGNED
  CANCELLED
}

enum VisaReviewLabel {
  AI_ESTIMATE
  OFFICIAL_CONFIRMATION_REQUIRED
  ADMIN_VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  role         Role
  status       AccountStatus @default(ACTIVE)
  name         String?
  locale       String        @default("ko")
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  oauthAccounts      OAuthAccount[]
  passwordResets     PasswordResetToken[]
  sessions           Session[]
  jobSeekerProfile   JobSeekerProfile?
  companyProfile     CompanyProfile?
  resumes            Resume[]
  applications       Application[]           @relation("JobSeekerApplications")
  jobScraps          JobScrap[]
  talentBookmarksAsSeeker TalentBookmark[]   @relation("BookmarkedTalent")
  notifications      Notification[]
  conversationMembers ConversationMember[]
  messages           Message[]
  visaProfile        VisaProfile?
  scoutOffersReceived ScoutOffer[]           @relation("ScoutTarget")
  interviewsAsSeeker Interview[]             @relation("InterviewSeeker")
  offersReceived     JobOffer[]              @relation("OfferSeeker")
  contractsAsSeeker  EmploymentContract[]    @relation("ContractSeeker")
  talentViewLogs     TalentViewLog[]         @relation("ViewedTalent")
  auditLogs          AuditLog[]
  reportsFiled       Report[]                @relation("Reporter")
  reportsAgainst     Report[]                @relation("ReportedUser")
  translationUsages  TranslationUsage[]

  @@index([role, status])
  @@index([createdAt])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JobSeekerProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  name                 String
  photoUrl             String?
  birthDate            DateTime? @db.Date
  gender               Gender    @default(UNSPECIFIED)
  email                String
  phone                String?
  residenceRegion      String?
  desiredWorkRegions   String[]  @default([])
  desiredJobCategories String[]  @default([])
  desiredSalaryMin     Int?
  desiredSalaryMax     Int?
  desiredEmploymentTypes String[] @default([])
  availableDate        DateTime? @db.Date
  introduction         String?
  skills               String[]  @default([])
  careerYears          Int       @default(0)
  languages            String[]  @default([])
  nationality          String?
  koreaResident        Boolean   @default(true)
  nativeLanguage       String?
  currentCountry       String?
  koreaLocation        String?
  koreanLevel          String?
  englishLevel         String?
  preferredLanguage    String    @default("ko")
  autoTranslateEnabled Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nationality])
  @@index([koreaResident])
}

model CompanyProfile {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  companyName        String
  businessNumber     String?
  representative     String?
  industry           String?
  companySize        String?
  description        String?
  address            String?
  website            String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  logoUrl            String?
  verificationStatus CompanyVerificationStatus  @default(PENDING)
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosts           JobPost[]
  applications       Application[]
  talentBookmarks    TalentBookmark[]
  talentViewLogs     TalentViewLog[]
  scoutOffers        ScoutOffer[]
  interviews         Interview[]
  jobOffers          JobOffer[]
  employmentContracts EmploymentContract[]
  conversations      Conversation[]

  @@index([verificationStatus])
  @@index([companyName])
}

model Resume {
  id              String           @id @default(cuid())
  userId          String
  title           String
  profileSummary  String?
  desiredJob      String?
  desiredLocation String?
  desiredSalary   Int?
  employmentType  String?
  availableDate   DateTime?        @db.Date
  visibility      ResumeVisibility @default(PRIVATE)
  status          ResumeStatus     @default(DRAFT)
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  careers         ResumeCareer[]
  educations      ResumeEducation[]
  certificates    ResumeCertificate[]
  languages       ResumeLanguage[]
  skills          ResumeSkill[]
  portfolios      ResumePortfolio[]
  desiredConditions ResumeDesiredCondition?
  applications    Application[]

  @@index([userId, isPrimary])
  @@index([visibility, status])
}

model ResumeCareer {
  id           String    @id @default(cuid())
  resumeId     String
  companyName  String
  jobTitle     String
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  isCurrent    Boolean   @default(false)
  description  String?
  leaveReason  String?
  sortOrder    Int       @default(0)
  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeEducation {
  id        String    @id @default(cuid())
  resumeId  String
  school    String
  major     String?
  degree    String?
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  status    String?
  sortOrder Int       @default(0)
  resume    Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeCertificate {
  id          String    @id @default(cuid())
  resumeId    String
  name        String
  issuer      String?
  issuedAt    DateTime? @db.Date
  sortOrder   Int       @default(0)
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeLanguage {
  id       String @id @default(cuid())
  resumeId String
  language String
  level    String
  sortOrder Int   @default(0)
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeSkill {
  id       String @id @default(cuid())
  resumeId String
  name     String
  level    String?
  sortOrder Int   @default(0)
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumePortfolio {
  id          String  @id @default(cuid())
  resumeId    String
  title       String
  url         String?
  description String?
  sortOrder   Int     @default(0)
  resume      Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeDesiredCondition {
  id             String  @id @default(cuid())
  resumeId       String  @unique
  jobCategories  String[] @default([])
  locations      String[] @default([])
  salaryMin      Int?
  salaryMax      Int?
  employmentTypes String[] @default([])
  otherNotes     String?
  resume         Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model JobPost {
  id                   String        @id @default(cuid())
  companyId            String
  title                String
  jobCategory          String?
  description          String
  responsibilities     String?
  requirements         String?
  preferredConditions  String?
  employmentType       String?
  salaryType           String?
  salaryMin            Int?
  salaryMax            Int?
  workLocation         String?
  workDays             String?
  workHours            String?
  breakTime            String?
  recruitmentCount     Int           @default(1)
  deadline             DateTime?
  foreignerAllowed     Boolean       @default(false)
  visaConditions       String?
  koreanLevel          String?
  housingSupport       Boolean       @default(false)
  mealSupport          Boolean       @default(false)
  transportationSupport Boolean      @default(false)
  educationRequirement String?
  careerRequirement    String?
  status               JobPostStatus @default(DRAFT)
  views                Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  company              CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications         Application[]
  scraps               JobScrap[]
  scoutOffers          ScoutOffer[]
  conversations        Conversation[]
  interviews           Interview[]
  jobOffers            JobOffer[]

  @@index([status, createdAt])
  @@index([companyId, status])
  @@index([jobCategory])
  @@index([workLocation])
  @@index([deadline])
  @@index([salaryMax])
}

model Application {
  id           String            @id @default(cuid())
  jobPostId    String
  jobSeekerId  String
  resumeId     String
  companyId    String
  status       ApplicationStatus @default(APPLIED)
  companyMemo  String?
  appliedAt    DateTime          @default(now())
  withdrawnAt  DateTime?
  updatedAt    DateTime          @updatedAt
  jobPost      JobPost           @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  jobSeeker    User              @relation("JobSeekerApplications", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  resume       Resume            @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  company      CompanyProfile    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  histories    ApplicationHistory[]
  interviews   Interview[]
  offers       JobOffer[]
  contracts    EmploymentContract[]
  conversation Conversation?

  @@unique([jobPostId, jobSeekerId])
  @@index([companyId, status])
  @@index([jobSeekerId, status])
  @@index([appliedAt])
}

model ApplicationHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model JobScrap {
  id          String   @id @default(cuid())
  userId      String
  jobPostId   String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPost     JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostId])
  @@index([userId])
}

model TalentBookmark {
  id              String         @id @default(cuid())
  companyId       String
  jobSeekerId     String
  createdAt       DateTime       @default(now())
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker       User           @relation("BookmarkedTalent", fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@unique([companyId, jobSeekerId])
  @@index([companyId])
}

model TalentViewLog {
  id          String         @id @default(cuid())
  companyId   String
  jobSeekerId String
  viewerUserId String?
  createdAt   DateTime       @default(now())
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker   User           @relation("ViewedTalent", fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([jobSeekerId])
}

model ScoutOffer {
  id          String      @id @default(cuid())
  companyId   String
  jobSeekerId String
  jobPostId   String?
  title       String
  message     String
  status      ScoutStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker   User        @relation("ScoutTarget", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobPost     JobPost?    @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@index([jobSeekerId, status])
  @@index([companyId, status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  linkUrl   String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Conversation {
  id            String               @id @default(cuid())
  companyId     String
  jobPostId     String?
  applicationId String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPost       JobPost?             @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  application   Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  members       ConversationMember[]
  messages      Message[]

  @@index([companyId, updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentMeta Json?
  translatedBody Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model VisaProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  visaType           String?
  visaStatus         String?
  issueDate          DateTime?       @db.Date
  expiryDate         DateTime?       @db.Date
  employmentAllowed  Boolean?
  verificationStatus VisaReviewLabel @default(OFFICIAL_CONFIRMATION_REQUIRED)
  adminNote          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([verificationStatus])
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  companyId     String
  jobSeekerId   String
  jobPostId     String?
  interviewType InterviewType   @default(ONLINE)
  scheduledAt   DateTime?
  durationMin   Int             @default(60)
  status        InterviewStatus @default(REQUESTED)
  meetingUrl    String?
  location      String?
  aiSummary     String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company       CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker     User            @relation("InterviewSeeker", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobPost       JobPost?        @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  aiPrescreen   AiPrescreen?

  @@index([companyId, scheduledAt])
  @@index([jobSeekerId, scheduledAt])
  @@index([status])
}

model AiPrescreen {
  id          String    @id @default(cuid())
  interviewId String    @unique
  questions   Json
  answers     Json?
  summary     String?
  highlights  String?
  followUps   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model JobOffer {
  id             String         @id @default(cuid())
  applicationId  String
  companyId      String
  jobSeekerId    String
  jobPostId      String?
  salary         Int?
  employmentType String?
  workLocation   String?
  startDate      DateTime?      @db.Date
  workingHours   String?
  benefits       String?
  message        String?
  status         OfferStatus    @default(PENDING)
  expiresAt      DateTime?
  respondedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  application    Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker      User           @relation("OfferSeeker", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobPost        JobPost?       @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  contracts      EmploymentContract[]

  @@index([jobSeekerId, status])
  @@index([companyId, status])
}

model EmploymentContract {
  id              String         @id @default(cuid())
  applicationId   String
  companyId       String
  jobSeekerId     String
  offerId         String?
  version         Int            @default(1)
  title           String
  originalContent String
  translatedContent String?
  translationLang String?
  status          ContractStatus @default(DRAFT)
  sentAt          DateTime?
  viewedAt        DateTime?
  agreedAt        DateTime?
  signedAt        DateTime?
  cancelledAt     DateTime?
  signatureMeta   Json?
  integrityHash   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSeeker       User           @relation("ContractSeeker", fields: [jobSeekerId], references: [id], onDelete: Cascade)
  offer           JobOffer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([applicationId, version])
  @@index([companyId, status])
  @@index([jobSeekerId, status])
}

model TranslationRecord {
  id           String   @id @default(cuid())
  sourceType   String
  sourceId     String?
  sourceLang   String?
  targetLang   String
  sourceText   String
  translatedText String
  provider     String
  createdAt    DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([createdAt])
}

model TranslationUsage {
  id         String   @id @default(cuid())
  userId     String?
  provider   String
  charCount  Int
  requestCount Int    @default(1)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model Report {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String?
  entityType     String?
  entityId       String?
  reason         String
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model HireIntegrationEvent {
  id          String    @id @default(cuid())
  applicationId String
  companyId   String
  jobSeekerId String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([applicationId])
}
