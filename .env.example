# PostgreSQL 연결 문자열. 실제 배포 환경에서는 시크릿 매니저로 주입한다.
DATABASE_URL="postgresql://user:password@localhost:5432/hihong_recruit?schema=public"

# 세션 JWT 서명 키 (32자 이상 랜덤 문자열). 운영 환경에서는 반드시 새로 생성/교체한다.
AUTH_SECRET="change-me-to-a-random-32+-char-secret"

# 최초 관리자 계정 시드용 (선택, npm run db:seed 에서 사용). 미설정 시 기본값 사용 후 반드시 변경할 것.
# SEED_ADMIN_EMAIL="admin@hihong-recruit.local"
# SEED_ADMIN_PASSWORD="ChangeMe123!"

# AI 번역 (선택). 설정하면 OpenAITranslationProvider가 활성화되고,
# 없으면 원문을 그대로 반환하는 NullTranslationProvider로 동작한다.
# 이 개발 환경에는 키가 없어 실제 OpenAI 호출은 테스트하지 못했다 — 배포 전 반드시 검증할 것.
# OPENAI_API_KEY="sk-..."

# 아래는 향후 단계에서 사용될 예정이며 아직 코드에서 참조하지 않는다 (미구현):
# - 이메일 발송 Provider API Key (SES/SendGrid 등)
